# Copy to .env and fill in. .env is git-ignored; never commit it.
ANTHROPIC_API_KEY=

# The login reviewers type into the browser's prompt.
ACCESS_USER=reviewer
ACCESS_PASSWORD=

# Optional: model to use (default: the SDK default).
# ASSISTANT_MODEL=

